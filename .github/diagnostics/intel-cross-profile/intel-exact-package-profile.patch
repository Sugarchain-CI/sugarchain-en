diff --git a/src/util/intel_stage_profile.h b/src/util/intel_stage_profile.h
new file mode 100644
index 0000000000..060244cbe9
--- /dev/null
+++ b/src/util/intel_stage_profile.h
@@ -0,0 +1,44 @@
+// Temporary diagnostic instrumentation. Do not ship in release builds.
+#ifndef BITCOIN_UTIL_INTEL_STAGE_PROFILE_H
+#define BITCOIN_UTIL_INTEL_STAGE_PROFILE_H
+#include <logging.h>
+#include <tinyformat.h>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+template <size_t N> struct IntelStageTotals {
+    const char* name;
+    std::array<const char*, N> labels;
+    uint64_t report_every{5000};
+    std::array<std::chrono::steady_clock::duration, N> elapsed{};
+    std::array<uint64_t, N> hits{};
+    std::chrono::steady_clock::duration total{};
+    uint64_t calls{0};
+};
+template <size_t N> class IntelStageScope {
+    using Clock = std::chrono::steady_clock;
+    IntelStageTotals<N>& m_totals;
+    Clock::time_point m_start{Clock::now()};
+    Clock::time_point m_last{m_start};
+public:
+    explicit IntelStageScope(IntelStageTotals<N>& totals) : m_totals{totals} {}
+    void Mark(size_t i) {
+        const auto now = Clock::now();
+        m_totals.elapsed[i] += now - m_last;
+        ++m_totals.hits[i];
+        m_last = now;
+    }
+    ~IntelStageScope() {
+        m_totals.total += Clock::now() - m_start;
+        ++m_totals.calls;
+        if (m_totals.calls > 10000 || m_totals.calls % m_totals.report_every != 0) return;
+        std::string line = strprintf("STAGEPROFILE %s calls=%u total_ms=%.3f", m_totals.name, m_totals.calls, std::chrono::duration<double, std::milli>(m_totals.total).count());
+        for (size_t i = 0; i < N; ++i) {
+            line += strprintf(" %s_ms=%.3f(%u)", m_totals.labels[i], std::chrono::duration<double, std::milli>(m_totals.elapsed[i]).count(), m_totals.hits[i]);
+        }
+        LogInfo("%s", line);
+    }
+};
+#endif
diff --git a/src/util/netprofile.h b/src/util/netprofile.h
new file mode 100644
index 0000000000..3331209c92
--- /dev/null
+++ b/src/util/netprofile.h
@@ -0,0 +1,50 @@
+// Temporary native synchronization diagnostics; not for release.
+#ifndef BITCOIN_UTIL_NETPROFILE_H
+#define BITCOIN_UTIL_NETPROFILE_H
+#include <logging.h>
+#include <array>
+#include <chrono>
+#include <cstdint>
+namespace netprofile {
+using Clock = std::chrono::steady_clock;
+enum Stage { PROCESS_MESSAGES, SEND_MESSAGES, MESSAGE_BLOCK, DESERIALIZE, MUTATION, REQUEST_BOOKKEEPING, PROCESS_BLOCK, HEADERS, HEADER_POW, HEADER_INDEX, MSG_WAIT, SNAPSHOT, NUM_STAGES };
+inline constexpr std::array<const char*, NUM_STAGES> NAMES{"process_messages", "send_messages", "message_block", "deserialize", "mutation", "request_bookkeeping", "process_block", "headers", "header_pow", "header_index", "msg_wait", "snapshot"};
+struct Stats {
+    Clock::time_point start{};
+    std::array<std::chrono::nanoseconds, NUM_STAGES> time{};
+    std::array<uint64_t, NUM_STAGES> calls{};
+    uint64_t blocks{0};
+};
+inline thread_local Stats stats;
+inline void Begin() { if (stats.start == Clock::time_point{}) stats = Stats{Clock::now()}; }
+inline double Elapsed() { return std::chrono::duration<double, std::milli>(Clock::now() - stats.start).count(); }
+class Scope {
+    Stage stage;
+    Clock::time_point start{Clock::now()};
+    bool active{true};
+public:
+    explicit Scope(Stage value) : stage{value} {}
+    void Stop() {
+        if (!active) return;
+        if (stats.start != Clock::time_point{}) {
+            stats.time[stage] += Clock::now() - start;
+            ++stats.calls[stage];
+        }
+        active = false;
+    }
+    ~Scope() { Stop(); }
+};
+inline void Event(const char* name, int64_t detail = 0) {
+    LogInfo("NETPROFILE event=%s elapsed_ms=%.3f blocks=%u detail=%d", name, Elapsed(), stats.blocks, detail);
+}
+inline void BlockDone() {
+    ++stats.blocks;
+    if (stats.blocks == 1) Event("first_block");
+    if (stats.blocks > 10000 || stats.blocks % 5000 != 0) return;
+    Event("blocks");
+    for (size_t i = 0; i < NUM_STAGES; ++i) {
+        LogInfo("NETPROFILE stage=%s calls=%u total_ms=%.3f", NAMES[i], stats.calls[i], std::chrono::duration<double, std::milli>(stats.time[i]).count());
+    }
+}
+}
+#endif
