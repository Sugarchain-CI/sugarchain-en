diff --git a/src/util/intel_stage_profile.h b/src/util/intel_stage_profile.h
new file mode 100644
index 0000000000..e28e3ec19b
--- /dev/null
+++ b/src/util/intel_stage_profile.h
@@ -0,0 +1,42 @@
+// Temporary diagnostic instrumentation. Do not ship in release builds.
+#ifndef BITCOIN_UTIL_INTEL_STAGE_PROFILE_H
+#define BITCOIN_UTIL_INTEL_STAGE_PROFILE_H
+#include <logging.h>
+#include <tinyformat.h>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+template <size_t N> struct IntelStageTotals {
+    const char* name;
+    std::array<const char*, N> labels;
+    std::array<std::chrono::steady_clock::duration, N> elapsed{};
+    std::array<uint64_t, N> hits{};
+    std::chrono::steady_clock::duration total{};
+    uint64_t calls{0};
+};
+template <size_t N> class IntelStageScope {
+    using Clock = std::chrono::steady_clock;
+    IntelStageTotals<N>& m_totals;
+    Clock::time_point m_start{Clock::now()};
+    Clock::time_point m_last{m_start};
+public:
+    explicit IntelStageScope(IntelStageTotals<N>& totals) : m_totals{totals} {}
+    void Mark(size_t i) {
+        const auto now = Clock::now();
+        m_totals.elapsed[i] += now - m_last;
+        ++m_totals.hits[i];
+        m_last = now;
+    }
+    ~IntelStageScope() {
+        m_totals.total += Clock::now() - m_start;
+        if (++m_totals.calls % 5000 != 0) return;
+        std::string line = strprintf("STAGEPROFILE %s calls=%u total_ms=%.3f", m_totals.name, m_totals.calls, std::chrono::duration<double, std::milli>(m_totals.total).count());
+        for (size_t i = 0; i < N; ++i) {
+            line += strprintf(" %s_ms=%.3f(%u)", m_totals.labels[i], std::chrono::duration<double, std::milli>(m_totals.elapsed[i]).count(), m_totals.hits[i]);
+        }
+        LogInfo("%s", line);
+    }
+};
+#endif
