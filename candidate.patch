@@ -29,6 +29,11 @@
 #include <stdint.h>
 #include <string.h>
 
+#if defined(__APPLE__) && defined(__aarch64__) && defined(__ARM_FEATURE_SHA2)
+#include <arm_neon.h>
+#define YESPOWER_APPLE_SHA2
