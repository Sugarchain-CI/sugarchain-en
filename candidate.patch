+BOOST_AUTO_TEST_CASE(validation_worker_wakes_idle_and_observes_active_enqueues)
+{
+    ValidationTaskRunner runner;
+    BOOST_REQUIRE(ValidationWorkerTestAccess::WaitForSleeper(runner));
+    std::vector<int> order;
+    std::promise<void> first_started, release_first, drained;
+    auto started{first_started.get_future()};
+    auto gate{release_first.get_future()};
+    auto finished{drained.get_future()};
+    runner.insert([&] {
+        order.push_back(1);
+        first_started.set_value();
+        gate.wait();
+        runner.insert([&] {
+            order.push_back(19);
+            drained.set_value();
+        });
+    });
+    const auto wake_status{started.wait_for(5s)};
+    for (int i{2}; i <= 18; ++i) {
+        runner.insert([&, i] { order.push_back(i); });
+    }
+    release_first.set_value();
+    const auto drain_status{finished.wait_for(5s)};
+    const bool idle_again{ValidationWorkerTestAccess::WaitForSleeper(runner)};
+    runner.stop();
+    // Keep all captured state alive even if a wakeup or drain failed.
+    runner.flush();
+
+    BOOST_CHECK(wake_status == std::future_status::ready);
+    BOOST_CHECK(drain_status == std::future_status::ready);
+    BOOST_CHECK(idle_again);
+    BOOST_REQUIRE_EQUAL(order.size(), 19U);
+    for (size_t i{0}; i < order.size(); ++i) BOOST_CHECK_EQUAL(order[i], i + 1);
+    BOOST_CHECK_EQUAL(runner.size(), 0U);
+}
