+        const size_t offset{include_height ? 0U : 16U};
+        BOOST_REQUIRE(a.size() >= offset && b.size() >= offset);
+        BOOST_CHECK_EQUAL_COLLECTIONS(a.begin() + offset, a.end(), b.begin() + offset, b.end());
