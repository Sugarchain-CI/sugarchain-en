+#if defined(__APPLE__) && defined(__aarch64__)
+struct ValidationWorkerTestAccess {
+    static bool WaitForSleeper(ValidationTaskRunner& runner)
+    {
+        const auto deadline{std::chrono::steady_clock::now() + 5s};
+        do {
+            if (WITH_LOCK(runner.m_mutex, return runner.m_worker_waiting)) return true;
+            std::this_thread::yield();
+        } while (std::chrono::steady_clock::now() < deadline);
+        return false;
+    }
+};
+#endif
